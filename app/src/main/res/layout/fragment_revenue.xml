<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:contentDescription="Quay lại"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tv_revenue_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="8dp"
            android:text="Thống kê doanh thu"
            android:textColor="#006241"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="50dp"
            android:layout_height="5dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text=""
            android:textColor="#006241"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layout_date_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btn_custom_date"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Lọc theo ngày"
                android:src="@drawable/calendar" />

            <TextView
                android:id="@+id/tv_selected_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Từ 01/01/2024 đến 01/05/2025"
                android:textColor="@android:color/black"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Thông tin tổng quan -->
    <LinearLayout
        android:id="@+id/layout_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_total_revenue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng doanh thu: "
                android:textColor="#4B4B4B"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tv_total_revenue_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="900000000VNĐ"
                android:textColor="#03A9F4"
                android:textSize="22sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tuần này: "
                android:textColor="#4B4B4B"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/revenue_value_this_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="900000000VNĐ"
                android:textColor="#00BCD4"
                android:textSize="18sp" />

            <View
                android:layout_width="15dp"
                android:layout_height="5dp" />

            <TextView
                android:id="@+id/revenue_change_value_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="+ 100 % so với tuần trước"
                android:textColor="#006241"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tháng này: "
                android:textColor="#4B4B4B"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/revenue_value_this_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="900000000VNĐ"
                android:textColor="#00BCD4"
                android:textSize="18sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="5dp" />

            <TextView
                android:id="@+id/revenue_change_value_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="+100 % so với tháng trước"
                android:textColor="#006241"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quý này: "
                android:textColor="#4B4B4B"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/revenue_value_this_quater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="900000000VNĐ"
                android:textColor="#00BCD4"
                android:textSize="18sp" />
            <View
                android:layout_width="20dp"
                android:layout_height="5dp" />
            <TextView
                android:id="@+id/revenue_change_value_quater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="+ 100 % so với tuần trước"
                android:textColor="#006241"
                android:textSize="12sp" />

        </LinearLayout>


    </LinearLayout>

    <!-- Biểu đồ -->
    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/chart_revenue"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@color/gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_summary" />

    <!-- Danh sách chi tiết doanh thu -->
