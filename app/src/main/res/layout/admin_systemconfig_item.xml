<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:padding="10dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/btn_edit_system"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.5">
                    <TextView
                        android:id="@+id/tv_FromValuePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="Price"
                        android:textSize="18sp"
                        android:textColor="@color/brown"/>

                    <TextView
                        android:id="@+id/tv_Currency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:hint="vnd"
                        android:textSize="14sp"
                        android:textColor="@color/brown"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/exchange"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.5">
                    <TextView
                        android:id="@+id/tv_ToValuePoint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:gravity="end"
                        android:hint="Point"
                        android:textColor="@color/brown"
                        android:textSize="18sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="Pts"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="5dp">

                <TextView
                    android:id="@+id/tv_FromDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:hint="Ngày bắt đầu"
                    android:textSize="16sp"
                    android:textColor="@color/brown"/>

                <TextView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:textAlignment="center"
                    android:text="-"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_EndDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:hint="Ngày kết thúc"
                    android:gravity="end"
                    android:textSize="16sp"
                    android:textColor="@color/brown"/>

            </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_edit_system"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_toStartOf="@+id/btn_delete_system"
            android:layout_marginEnd="10dp"
            android:layout_centerVertical="true"
            android:src="@drawable/setting"
            android:background="@color/white"
            android:focusable="true"
            android:clickable="true"/>

        <ImageButton
            android:id="@+id/btn_delete_system"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/recycling_bin"
            android:background="@color/white"
            android:focusable="true"
            android:clickable="true"/>

    </RelativeLayout>

</androidx.cardview.widget.CardView>