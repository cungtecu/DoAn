<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#ffffff">

    <!-- Nút quay lại -->
    <LinearLayout
        android:id="@+id/header_top_product"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_back"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_gravity="top"
            android:clickable="true"
            android:contentDescription="Quay lại" />

        <TextView
            android:id="@+id/tv_revenue_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sản phẩm bán chạy"
            android:layout_gravity="top"
            android:textColor="#006241"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <TextView
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#006241"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <LinearLayout
            android:id="@+id/layout_date_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/btn_custom_date"
                android:layout_width="32dp"
                android:layout_gravity="center"
                android:layout_height="32dp"
                android:src="@drawable/calendar"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Lọc theo ngày" />

            <TextView
                android:id="@+id/tv_selected_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Từ 01/01/2024 đến 01/05/2025"
                android:textSize="14sp"
                android:layout_marginStart="8dp"
                android:textColor="@android:color/black" />
        </LinearLayout>
    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        android:backgroundTint="@color/gray"
        app:cardCornerRadius="15dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tv_top_product"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp" />
    </androidx.cardview.widget.CardView>
</LinearLayout>