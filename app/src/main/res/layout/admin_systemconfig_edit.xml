<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DDDDDD">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/top_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/imageViewa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="TroisH System Config"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@+id/constraintLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_search"
            android:orientation="horizontal"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:padding="13dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sửa Hệ Thống Tích Điểm"
                android:fontFamily="@font/font_main"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/brown"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="5dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">
            <EditText
                android:id="@+id/editFromDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/top_button_background2"
                android:padding="15dp"
                android:focusable="true"
                android:clickable="true"
                android:textSize="16sp"
                android:hint="Ngày bắt đầu"
                android:textColor="@color/brown" />

            <EditText
                android:id="@+id/editEndDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/top_button_background2"
                android:padding="15dp"
                android:focusable="true"
                android:clickable="true"
                android:textSize="16sp"
                android:layout_marginTop="10dp"
                android:hint="Ngày kết thúc"
                android:textColor="@color/brown"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">
                <EditText
                    android:id="@+id/edit_FromValuePrice"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/top_button_background2"
                    android:hint="Money"
                    android:padding="15dp"
                    android:textColor="@color/brown"
                    android:textSize="16sp"
                    android:inputType="number"
                    android:layout_marginRight="10dp"/>

                <Spinner
                    android:id="@+id/spinnerCurrencies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="15dp"
                    android:textSize="16sp"
                    android:background="@drawable/top_button_background3"
                    android:focusable="true"
                    android:clickable="true"/>

            </LinearLayout>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/renew"
                android:padding="5dp"
                android:layout_marginLeft="90dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edit_ToValuePoint"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/top_button_background2"
                    android:hint="Point"
                    android:padding="15dp"
                    android:textColor="@color/brown"
                    android:textSize="16sp"
                    android:inputType="number"
                    android:layout_marginRight="10dp"/>
                <Button
                    android:id="@+id/btnSaveSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lưu"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:padding="15dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:textColor="@color/white"
                    android:background="@drawable/top_button_background_white"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>